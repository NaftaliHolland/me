---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site, sections } from '../config';

interface Props { title?: string; description?: string }
const { title, description = site.bio } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const nav = [...sections.map((s) => ({ label: s.label, href: `/#${s.key}` })), { label: 'Resume', href: '/resume' }];
---
<!doctype html>
<html lang="en" class="scroll-pt-16">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfcfa" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="sticky top-0 z-10 bg-paper/90 backdrop-blur-sm">
      <div class="mx-auto flex max-w-2xl flex-wrap items-baseline justify-between gap-x-8 gap-y-1 px-6 py-4">
        <a href="/" class="font-semibold tracking-tight">{site.name}</a>
        <nav aria-label="Main" class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
          {nav.map((n) => <a href={n.href} class="hover:text-ink">{n.label}</a>)}
        </nav>
      </div>
    </header>
    <div class="mx-auto max-w-3xl px-6 pt-14 pb-24 sm:pt-20">
      <main><slot /></main>
      <footer class="mt-24 text-sm text-faint">© {new Date().getFullYear()} {site.name}</footer>
    </div>
  </body>
</html>
