---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { site, sections } from '../config';
import { getEntries } from '../lib/content';

const work = sections.find((s) => s.key === 'work')!;
const entries = await getEntries('experience');
---
<Base title="Resume">
  <h1 class="text-[1.7rem] font-semibold tracking-tight">Resume</h1>
  <p class="mt-3 max-w-prose text-muted">{site.about}</p>
  <p class="mt-4 text-sm">
    <a href="https://bucket-3.rabbitam.com/NaftaliHolland_Resume.pdf" target="_blank" class="text-ink underline decoration-rule underline-offset-4 hover:text-accent hover:decoration-accent">Get my resume ↗</a>
  </p>
  <h2 class="mt-14 text-sm font-normal text-muted">Experience</h2>
  <ul class="mt-4 -my-2">{entries.map((entry) => <Entry entry={entry} section={work} />)}</ul>
  <h2 class="mt-14 text-sm font-normal text-muted">Skills</h2>
  <p class="mt-4 text-muted">{site.skills.join(', ')}</p>
</Base>
